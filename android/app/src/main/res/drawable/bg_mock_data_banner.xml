<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral gray outline, deliberately distinct from bg_warning_banner.xml
     (amber, for transient location errors), so the "this data isn't real"
     label reads as a permanent, calmer notice rather than an error/alert.
     A dashed stroke was considered but dashed shape strokes don't reliably
     render under hardware acceleration on some Android versions, so a
     solid stroke is used instead. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#cc1a1a1a" />
    <stroke android:width="1dp" android:color="#888888" />
    <corners android:radius="6dp" />
</shape>
