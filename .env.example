# Copy this file to .env and adjust as needed for local development.
# NEVER commit a real .env file — it is git-ignored by default.

# --- Ports (host side) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# --- PostGIS (used from Milestone 5 onward) ---
POSTGRES_USER=khaochalak
POSTGRES_PASSWORD=khaochalak
POSTGRES_DB=khaochalak

# --- Backend app ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgresql://khaochalak:khaochalak@localhost:5432/khaochalak

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
